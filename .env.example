# Runner Builder configuration. Every variable is optional; the defaults run a
# local, single-machine builder. Copy to .env and export, or set them in the
# shell that runs `npm run dev`. Placeholders only: never commit real values.

# Where projects, the database and the agent's Codex home live.
# BUILDER_HOME=~/.runner-builder

# Postgres instead of the default SQLite file.
# BUILDER_DATABASE_URL=postgres://runner_builder:runner_builder@127.0.0.1:5433/runner_builder

# Orchestrator and UI ports.
# PORT=4310
# BUILDER_WEB_PORT=4311

# The agent: model and reasoning level handed to `codex exec`.
# BUILDER_MODEL=gpt-6-astra
# BUILDER_REASONING=ultra
# BUILDER_SANDBOX=workspace-write

# Run the agent from your own ~/.codex instead of the builder-owned home.
# BUILDER_CODEX_ISOLATED=0

# Skills linked into the agent's home: Codex plugins by name, Claude plugin
# skills by name, and named folders from ~/.claude/skills.
# BUILDER_CODEX_PLUGINS=expo
# BUILDER_CLAUDE_PLUGIN_SKILLS=react-native-patterns,liquid-glass-design
# BUILDER_CLAUDE_SKILLS=apple-design,design-taste-frontend,web-design-guidelines

# Expo MCP server for the agent (docs, expo install, EAS builds). Off with 0.
# BUILDER_EXPO_MCP=1

# Type-check mobile projects after every turn and give the agent one fix turn.
# BUILDER_SELF_CHECK=1

# Environment for a repository project's dev server, as KEY=VALUE pairs
# separated by commas. Example: point a frontend's dev proxy at a staging API.
# BUILDER_PREVIEW_ENV=RUNNER_DEV_API_TARGET=https://api-staging.example.com

# Read-only team memory through a MemPalace MCP server. Both are required.
# MEMPALACE_TOKEN=
# BUILDER_MEMPALACE_URL=https://mempalace.example.com/mcp
